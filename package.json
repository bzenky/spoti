{
  "name": "spoti",
  "version": "0.1.0",
  "description": "A local-first command-line client for controlling Spotify",
  "type": "module",
  "bin": {
    "spoti": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzenky/spoti.git"
  },
  "homepage": "https://github.com/bzenky/spoti#readme",
  "bugs": {
    "url": "https://github.com/bzenky/spoti/issues"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "spotify",
    "cli",
    "spotify-connect"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "open": "^11.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
